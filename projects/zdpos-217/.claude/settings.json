{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//tmp/**)",
      "WebFetch(domain:phpunit.de)",
      "WebFetch(domain:docs.anthropic.com)",
      "Skill(openspec:proposal)",
      "Skill(create-skill)",
      "Skill(playwright-cli)",
      "Skill(review-spec)",
      "Skill(codex-code-review)",
      "mcp__codex__codex",
      "mcp__codex__codex-reply",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_claude-mem_mcp-search__build_corpus",
      "mcp__plugin_claude-mem_mcp-search__get_observations",
      "mcp__plugin_claude-mem_mcp-search__list_corpora",
      "mcp__plugin_claude-mem_mcp-search__search",
      "mcp__plugin_claude-mem_mcp-search__smart_outline",
      "mcp__plugin_claude-mem_mcp-search__smart_search",
      "mcp__plugin_claude-mem_mcp-search__smart_unfold",
      "mcp__plugin_claude-mem_mcp-search__timeline",
      "mcp__mysql-dev-ro__mysql_query",
      "mcp__gitnexus__impact",
      "mcp__gitnexus__detect_changes",
      "mcp__gitnexus__query",
      "Bash(git:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(docker --version)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker inspect:*)",
      "Bash(docker ps:*)",
      "Bash(docker-compose up:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx jest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)",
      "Bash(npx openspec:*)",
      "Bash(npx gitnexus:*)",
      "Bash(npx eslint:*)",
      "Bash(playwright-cli:*)",
      "Bash(php:*)",
      "Bash(pip3 install:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv tool *)",
      "Bash(codex --help)",
      "Bash(codex exec *)",
      "Bash(cx:*)",
      "Bash(openspec:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(command -v *)",
      "Bash(command -v jq)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(iconv:*)",
      "Bash(ls:*)",
      "Bash(\\ls *)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(bash:*)",
      "Bash(cd:*)",
      "Bash(chmod +x:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(sqlite3 *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git rebase:*)"
    ],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__mysql-.*__mysql_query",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-mysql-sensitive-select.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/dhpk/scripts/hooks/pre-agent-warmstart.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-skill-index.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/user-prompt-lang-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-lang-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "ZDPOS_HOOK_PROFILE": "standard"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/statusline.sh"
  },
  "pluginConfigs": {
    "dhpk@dhpk": {
      "options": {
        "hook_profile": "standard",
        "review_trigger_extra_paths": [
          "db:infrastructure/Repositories/",
          "sec:infrastructure/Configuration/",
          "mig:protected/migrations/"
        ]
      }
    }
  }
}
